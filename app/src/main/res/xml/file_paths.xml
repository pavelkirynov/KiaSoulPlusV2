<?xml version="1.0" encoding="utf-8"?>
<!--
    Рівно ті шляхи, які застосунок віддає назовні, і жодного зайвого: FileProvider
    відкриває тільки перелічене тут, тож решта власних файлів лишається закритою.

    journal — журнал діагностики, який людина надсилає, коли щось поводиться не так.
    share   — готовий пакунок із даними авто, зібраний для передачі на інший телефон.
              Лежить у кеші навмисно: це не дані, а їхня копія на один раз, і система
              має право прибрати її, щойно знадобиться місце.
-->
<paths>
    <files-path name="journal" path="journal/" />
    <cache-path name="share" path="." />
</paths>
